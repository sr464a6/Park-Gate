# Copy this file to .env and fill in what you have.
# Nothing here is fake -- whatever provider you configure is actually used to send the OTP.

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
GATE_API_KEY=change-this-gate-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- OTP delivery: configure AT LEAST ONE of the blocks below ----
# The server tries them in this order: Fonnte (WhatsApp) -> Twilio (SMS) -> SMTP (Email).
# If none are configured, the server falls back to DEV MODE: the code is printed in the
# server terminal (and returned in the API response, clearly marked "dev_otp") so you can
# still test the whole flow end to end before you have a paid gateway account.

# --- Option A: Fonnte (WhatsApp OTP, popular in Indonesia, has a free trial token) ---
# https://fonnte.com
FONNTE_TOKEN=

# --- Option B: Twilio (SMS, works worldwide) ---
# https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Option C: SMTP email (free with a Gmail App Password) ---
# Registration will additionally ask for an email address if this is the active channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Park Gate <no-reply@parkgate.local>"
